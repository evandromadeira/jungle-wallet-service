# Local development only. This bootstrap account is an administrator.
# Use this administrator only for explicit role provisioning; workers use the restricted identity below.
POSTGRES_DB=jungle_wallet
POSTGRES_USER=jungle_admin
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5433

# Local emulator credentials; export these for host execution.
SQS_PORT=4566

# Local worker process configuration. The executable does not load .env automatically.
# Export these variables in the terminal; adapt password/ports to your actual local setup.
WALLET_DATABASE_URL=postgres://jungle_worker:local-worker-only@127.0.0.1:5433/jungle_wallet?sslmode=disable
WALLET_SQS_ENDPOINT=http://127.0.0.1:4566
WALLET_INPUT_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-transactions.fifo
WALLET_OUTPUT_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/jungle-wallet-events
WALLET_PROVIDER_ID=provider-a
WALLET_CONSUMER_NAME=wagers-provider-a

# Dedicated local roles. Export these before running scripts/Set-DatabaseAccess.ps1.
# Roles are created if absent; rerunning does not change existing passwords.
WALLET_MIGRATOR_USER=jungle_migrator
WALLET_MIGRATOR_PASSWORD=local-migrator-only
WALLET_WORKER_USER=jungle_worker
WALLET_WORKER_PASSWORD=local-worker-only
WALLET_MIGRATION_DATABASE_URL=postgres://jungle_migrator:local-migrator-only@127.0.0.1:5433/jungle_wallet?sslmode=disable
# Local OIDC fixture only. Client secrets in the realm JSON are public test values.
KEYCLOAK_PORT=8081

# Optional HTTP server: configure all three variables together, or leave all unset.
WALLET_HTTP_ADDRESS=127.0.0.1:8080
WALLET_OIDC_ISSUER=http://127.0.0.1:8081/realms/jungle-wallet
WALLET_OIDC_AUDIENCE=wallet-api

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WALLET_HTTP_PORT=8080
